{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@riddle/suite-credits": ["packages/suite-credits/src/index.ts"],
      "@riddle/suite-chrome": ["packages/suite-chrome/src/index.ts"],
      "@riddle/suite-game-economy": ["packages/suite-game-economy/src/index.ts"]
    }
  },
  "include": ["src"]
}
